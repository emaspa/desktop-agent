#!/usr/bin/env python3
"""desktop-agent: a system-admin agent for KDE Plasma, backed by Claude Code or Codex.

Subcommands:
  status [--refresh]     JSON for the Plasma widget (usage limits, health checks, actions)
  launch [--agent ID] [PROMPT...]
                         open the active agent (or ID) in a terminal, in the admin workspace
  agents                 JSON: configured agents, the active one, models and permission choices
  agents set JSON        replace the agent list: {"active": ID, "agents": [...]}
  use ID                 make agent ID the active one
  workspace              refresh the agent instructions in the workspace and print its path
  diagnose PID           launch the agent on a core dump
  watch                  long-running: crash notifications + usage-limit alerts
  mute EXE | unmute EXE  silence crash notifications for one program
  shortcut [KEYS]        show or set the open-agent hotkey, e.g. "Meta+Shift+A" ("" clears it)
  config                 print the effective config and its path
"""

import base64
import fcntl
import json
import os
import shlex
import shutil
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "desktop-agent" / "config.json"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "desktop-agent"
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "desktop-agent"
WORKSPACE = DATA_DIR / "workspace"
APP_ROOT = Path(__file__).resolve().parent.parent  # the checkout or installed copy this script runs from
CLAUDE_DIR = Path(os.environ.get("CLAUDE_CONFIG_DIR", HOME / ".claude"))
CODEX_DIR = Path(os.environ.get("CODEX_HOME", HOME / ".codex"))

USAGE_TTL = 300          # seconds between plan-usage fetches
UPDATES_TTL = 3600       # seconds between checkupdates runs
USAGE_ALERT_PERCENT = 90

DEFAULT_CONFIG = {
    # Terminal command; the agent invocation is appended after it.
    "terminal": ["konsole", "--workdir", "{workspace}", "-p", "tabtitle={name}", "-e"],
    # Agents you can switch between. "type" picks the CLI (see AGENT_TYPES); "model" and
    # "permissions" empty mean the CLI's own defaults; "args" are extra CLI arguments.
    "active_agent": "claude",
    "agents": [
        {"id": "claude", "name": "Claude Code", "type": "claude", "model": "", "permissions": "", "args": []},
        {"id": "codex", "name": "Codex (ChatGPT)", "type": "codex", "model": "", "permissions": "", "args": []},
    ],
    "crash_capture": True,
    "muted": [],
    "disk_mounts": ["/", "/home"],
    "actions": [
        {"label": "Update system", "icon": "system-software-update",
         "prompt": "Update this CachyOS system: read any Arch/CachyOS news that needs manual intervention, "
                   "run the update, then handle new .pacnew files and tell me if a reboot is needed."},
        {"label": "Health check", "icon": "checkmark",
         "prompt": "Run a health check of this machine: failed units, journal errors this boot, recent "
                   "crashes, disk and btrfs health, SMART status, temperatures. Report what needs attention "
                   "and propose fixes; don't change anything yet."},
        {"label": "Free disk space", "icon": "edit-clear-all",
         "prompt": "Find what's using disk space and propose a cleanup: pacman/yay caches, orphans, "
                   "journal size, old snapper snapshots, large caches in my home. Ask before deleting."},
        {"label": "Boot errors", "icon": "dialog-warning",
         "prompt": "Review errors and warnings from the current boot (journalctl -b -p warning). "
                   "Group them, explain which matter, and fix the ones worth fixing."},
    ],
}


# ---------------------------------------------------------------- helpers

def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    try:
        cfg.update(json.loads(CONFIG_PATH.read_text()))
    except FileNotFoundError:
        pass
    except json.JSONDecodeError as e:
        print(f"desktop-agent: ignoring invalid {CONFIG_PATH}: {e}", file=sys.stderr)
    return cfg


def save_config(cfg):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    # Only persist keys that differ from defaults, so new defaults reach existing installs.
    out = {k: v for k, v in cfg.items() if DEFAULT_CONFIG.get(k) != v}
    CONFIG_PATH.write_text(json.dumps(out, indent=2) + "\n")


def run(cmd, timeout=20):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired):
        return -1, ""


def which(name):
    found = shutil.which(name)
    if found:
        return found
    for d in (HOME / ".local/bin", Path("/usr/local/bin"), Path("/usr/bin")):
        if (d / name).is_file():
            return str(d / name)
    return None


def human_delta(seconds):
    seconds = int(max(0, seconds))
    if seconds < 3600:
        return f"{max(1, seconds // 60)}m"
    if seconds < 86400:
        h, m = divmod(seconds // 60, 60)
        return f"{h}h {m}m" if m else f"{h}h"
    d, h = divmod(seconds // 3600, 24)
    return f"{d}d {h}h" if h else f"{d}d"


def parse_iso(ts):
    try:
        return datetime.fromisoformat(ts).timestamp()
    except (TypeError, ValueError):
        return None


class Cache:
    """JSON cache of slow results, guarded by a file lock so concurrent callers don't duplicate work."""

    def __init__(self):
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        self.path = CACHE_DIR / "cache.json"
        self.lock_path = CACHE_DIR / "cache.lock"

    def get(self, key, ttl, compute, force=False):
        with open(self.lock_path, "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            data = self._read()
            entry = data.get(key)
            if not force and entry and time.time() - entry["at"] < ttl:
                return entry["value"]
            value = compute()
            data = self._read()
            data[key] = {"at": time.time(), "value": value}
            tmp = self.path.with_suffix(".tmp")
            tmp.write_text(json.dumps(data))
            tmp.replace(self.path)
            return value

    def _read(self):
        try:
            return json.loads(self.path.read_text())
        except (FileNotFoundError, json.JSONDecodeError):
            return {}


# ---------------------------------------------------------------- agents

# Each permission choice maps to the CLI's own flags. "" passes nothing, so the CLI's config applies.
AGENT_TYPES = {
    "claude": {
        "label": "Claude Code", "command": "claude", "provider": "claude", "model_flag": "--model",
        "permissions": [
            ("", "Claude Code's own settings", []),
            ("plan", "Read-only: plan mode, no changes", ["--permission-mode", "plan"]),
            ("manual", "Ask before edits and commands", ["--permission-mode", "manual"]),
            ("acceptEdits", "Auto-approve file edits, ask for commands", ["--permission-mode", "acceptEdits"]),
            ("auto", "Auto mode: approve safe actions, ask about risky ones", ["--permission-mode", "auto"]),
            ("bypass", "Never ask (full access)", ["--dangerously-skip-permissions"]),
        ],
    },
    "codex": {
        "label": "Codex", "command": "codex", "provider": "chatgpt", "model_flag": "--model",
        "permissions": [
            ("", "Codex's own settings", []),
            ("read-only", "Read-only sandbox", ["--sandbox", "read-only", "--ask-for-approval", "on-request"]),
            ("workspace", "Sandboxed to the workspace, asks to go outside it",
             ["--sandbox", "workspace-write", "--ask-for-approval", "on-request"]),
            ("approve-for-me", "Auto-review: a reviewer model answers approval requests", ["--approve-for-me"]),
            ("full-access", "Full access, the model asks when it judges it risky",
             ["--sandbox", "danger-full-access", "--ask-for-approval", "on-request"]),
            ("bypass", "Never ask (full access, no sandbox)", ["--dangerously-bypass-approvals-and-sandbox"]),
        ],
    },
}


def agent_list(cfg):
    """The configured agents with missing fields filled in; unknown types are dropped."""
    agents = []
    for a in cfg.get("agents") or []:
        if a.get("type") not in AGENT_TYPES or not a.get("id"):
            continue
        perms = {p[0] for p in AGENT_TYPES[a["type"]]["permissions"]}
        agents.append({"id": str(a["id"]), "type": a["type"],
                       "name": a.get("name") or AGENT_TYPES[a["type"]]["label"],
                       "model": a.get("model") or "",
                       "permissions": a.get("permissions") if a.get("permissions") in perms else "",
                       "args": list(a.get("args") or [])})
    return agents or json.loads(json.dumps(DEFAULT_CONFIG["agents"]))


def get_agent(cfg, agent_id=None):
    agents = agent_list(cfg)
    wanted = agent_id or cfg.get("active_agent")
    return next((a for a in agents if a["id"] == wanted), agents[0])


def model_choices(agent_type):
    """Models to suggest in the settings page. Free text is always allowed too."""
    if agent_type == "claude":
        try:  # Claude Code's model picker (includes gateway models when one is configured)
            opts = json.loads((CLAUDE_DIR / "settings.json").read_text())["modelPicker"]["options"]
            return [{"id": o["model"], "label": o.get("label") or o["model"]} for o in opts if o.get("model")]
        except (FileNotFoundError, KeyError, TypeError, json.JSONDecodeError):
            return [{"id": m, "label": m.title()} for m in ("opus", "sonnet", "haiku")]
    if agent_type == "codex":
        try:
            models = json.loads((CODEX_DIR / "models_cache.json").read_text())["models"]
            return [{"id": m["slug"], "label": m.get("display_name") or m["slug"]}
                    for m in models if m.get("visibility", "list") == "list"]
        except (FileNotFoundError, KeyError, TypeError, json.JSONDecodeError):
            return []
    return []


def agents_info(cfg):
    return {
        "active": get_agent(cfg)["id"],
        "agents": agent_list(cfg),
        "types": {t: {"label": d["label"], "installed": bool(which(d["command"])),
                      "models": model_choices(t),
                      "permissions": [{"id": p[0], "label": p[1]} for p in d["permissions"]]}
                  for t, d in AGENT_TYPES.items()},
    }


def set_agents(payload):
    data = json.loads(payload)
    cfg = load_config()
    agents = agent_list({"agents": data.get("agents")})
    ids = [a["id"] for a in agents]
    if len(set(ids)) != len(ids):
        raise ValueError("agent ids must be unique")
    cfg["agents"] = agents
    cfg["active_agent"] = data.get("active") if data.get("active") in ids else ids[0]
    save_config(cfg)


def use_agent(agent_id):
    cfg = load_config()
    if agent_id not in [a["id"] for a in agent_list(cfg)]:
        raise ValueError(f"no agent with id {agent_id!r}")
    cfg["active_agent"] = agent_id
    save_config(cfg)


# ---------------------------------------------------------------- plan usage

def window_label(seconds):
    return {18000: "Session", 86400: "Daily", 604800: "Weekly"}.get(seconds) or f"{human_delta(seconds)} window"


def http_json(url, headers):
    req = urllib.request.Request(url, headers={"User-Agent": "desktop-agent/1.0", "Accept": "application/json",
                                               **headers})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.load(resp), None
    except urllib.error.HTTPError as e:
        return None, f"Usage request failed (HTTP {e.code})"
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as e:
        return None, f"Usage request failed ({getattr(e, 'reason', e)})"


def jwt_claims(token):
    try:
        payload = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
    except (IndexError, ValueError, AttributeError):
        return {}


CLAUDE_PLANS = {"max": "Max", "pro": "Pro", "team": "Team", "enterprise": "Enterprise"}
CHATGPT_PLANS = {"free": "Free", "plus": "Plus", "pro": "Pro", "prolite": "Pro Lite", "team": "Team",
                 "business": "Business", "enterprise": "Enterprise", "edu": "Edu"}

# Neither fetcher ever refreshes a token: rotating it here could sign the CLI out, so an expired
# token just reports as stale until the CLI's next session renews it.


def fetch_claude_usage():
    """Claude plan limits, read with Claude Code's own OAuth login."""
    try:
        oauth = json.loads((CLAUDE_DIR / ".credentials.json").read_text())["claudeAiOauth"]
    except (FileNotFoundError, KeyError, json.JSONDecodeError):
        return {"error": "Not signed in to Claude Code"}

    tier = oauth.get("rateLimitTier") or ""
    plan = CLAUDE_PLANS.get(oauth.get("subscriptionType"), (oauth.get("subscriptionType") or "").title())
    for mult in ("20x", "5x"):
        if mult in tier:
            plan = f"{plan} {mult}"
    result = {"plan": plan, "limits": []}

    if oauth.get("expiresAt", 0) / 1000 < time.time():
        result["error"] = "Login expired; start Claude Code once to refresh it"
        return result

    body, err = http_json("https://api.anthropic.com/api/oauth/usage",
                          {"Authorization": f"Bearer {oauth['accessToken']}", "anthropic-beta": "oauth-2025-04-20"})
    if err:
        result["error"] = err
        return result

    limits = []
    for lim in body.get("limits") or []:
        group = (lim.get("group") or lim.get("kind") or "limit").replace("_", " ")
        label = {"weekly": "Weekly", "session": "Session", "five hour": "Session"}.get(group, group.title())
        scope = ((lim.get("scope") or {}).get("model") or {}).get("display_name")
        if scope:
            label += f" · {scope}"
        limits.append({"label": label, "percent": lim.get("percent") or 0,
                       "reset_ts": parse_iso(lim.get("resets_at"))})
    if not limits:  # older response shape
        for key, label in (("five_hour", "Session"), ("seven_day", "Weekly")):
            if body.get(key):
                limits.append({"label": label, "percent": body[key].get("utilization") or 0,
                               "reset_ts": parse_iso(body[key].get("resets_at"))})
    result["limits"] = limits
    return result


def fetch_chatgpt_usage():
    """ChatGPT plan limits for Codex, read with Codex's own ChatGPT login."""
    try:
        auth = json.loads((CODEX_DIR / "auth.json").read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {"error": "Codex isn't signed in"}
    tokens = auth.get("tokens") or {}
    if not tokens.get("access_token"):
        return {"error": "Codex uses an API key; plan limits need a ChatGPT login"}

    plan_type = (jwt_claims(tokens.get("id_token")).get("https://api.openai.com/auth") or {}).get("chatgpt_plan_type")
    result = {"plan": CHATGPT_PLANS.get(plan_type, (plan_type or "").title()), "limits": []}
    if (jwt_claims(tokens["access_token"]).get("exp") or 0) < time.time():
        result["error"] = "Login expired; start Codex once to refresh it"
        return result

    headers = {"Authorization": f"Bearer {tokens['access_token']}"}
    if tokens.get("account_id"):
        headers["ChatGPT-Account-Id"] = tokens["account_id"]
    body, err = http_json("https://chatgpt.com/backend-api/wham/usage", headers)
    if err:
        result["error"] = err
        return result
    if body.get("plan_type"):
        result["plan"] = CHATGPT_PLANS.get(body["plan_type"], body["plan_type"].title())

    def windows(rate_limit, suffix=""):
        for key in ("primary_window", "secondary_window"):
            w = (rate_limit or {}).get(key)
            if w:
                result["limits"].append({"label": window_label(w.get("limit_window_seconds")) + suffix,
                                         "percent": w.get("used_percent") or 0, "reset_ts": w.get("reset_at")})

    windows(body.get("rate_limit"))
    for extra in body.get("additional_rate_limits") or []:
        if isinstance(extra, dict):
            name = extra.get("limit_name") or extra.get("metered_feature") or ""
            windows(extra.get("rate_limit"), f" · {name}" if name else "")
    return result


PROVIDERS = {
    "claude": {"name": "Claude", "login": CLAUDE_DIR / ".credentials.json", "fetch": fetch_claude_usage},
    "chatgpt": {"name": "ChatGPT", "login": CODEX_DIR / "auth.json", "fetch": fetch_chatgpt_usage},
}


def usage_all(cache, force=False, first=None):
    """Plan usage for every provider that has a login on this machine, `first` provider first."""
    out = []
    for pid in sorted(PROVIDERS, key=lambda p: p != first):
        prov = PROVIDERS[pid]
        if not prov["login"].exists():
            continue
        usage = dict(cache.get(f"usage:{pid}", USAGE_TTL, prov["fetch"], force))
        usage.update(id=pid, name=prov["name"])
        now = time.time()
        for lim in usage.get("limits", []):
            reset = lim.get("reset_ts")
            lim["detail"] = f"{round(lim['percent'])}%" + (f" · resets in {human_delta(reset - now)}" if reset else "")
        out.append(usage)
    return out


# ---------------------------------------------------------------- health checks

def fetch_updates():
    repo, aur = [], []
    if which("checkupdates"):
        code, out = run(["checkupdates", "--nocolor"], timeout=120)
        if code == 0:
            repo = [line.split()[0] for line in out.splitlines() if line.strip()]
    helper = which("paru") or which("yay")
    if helper:
        code, out = run([helper, "-Qua"], timeout=120)
        aur = [line.split()[0] for line in out.splitlines() if line.strip() and not line.startswith(":")]
    return {"repo": repo, "aur": aur}


def check_updates(cache, force):
    u = cache.get("updates", UPDATES_TTL, fetch_updates, force)
    checks = []
    n = len(u["repo"]) + len(u["aur"])
    if n:
        parts = [f"{len(u['repo'])} repo"] + ([f"{len(u['aur'])} AUR"] if u["aur"] else [])
        checks.append({"id": "updates", "icon": "system-software-update", "level": "warn",
                       "title": f"{n} update{'s' if n != 1 else ''} available",
                       "detail": ", ".join(parts), "action": "Update",
                       "prompt": DEFAULT_CONFIG["actions"][0]["prompt"]})
    else:
        checks.append({"id": "updates", "icon": "system-software-update", "level": "ok",
                       "title": "System up to date", "detail": ""})
    return checks


def check_pacnew():
    # Not cached: pacdiff -o only reads the pacman db (well under a second), and a stale list
    # would keep nagging about files that were already merged.
    if not which("pacdiff"):
        return []
    _, out = run(["pacdiff", "-o"], timeout=60)
    files = [line for line in out.splitlines() if line.strip()]
    checks = []
    if files:
        checks.append({"id": "pacnew", "icon": "document-edit", "level": "warn",
                       "title": f"{len(files)} .pacnew file{'s' if len(files) != 1 else ''}",
                       "detail": ", ".join(Path(f).name for f in files[:3]) + ("…" if len(files) > 3 else ""),
                       "action": "Merge",
                       "prompt": "Review and merge these .pacnew files, keeping my local changes where they "
                                 "matter and taking upstream changes otherwise: " + " ".join(files)})
    return checks


def check_reboot():
    running = os.uname().release
    if not Path("/usr/lib/modules", running).is_dir():
        return [{"id": "reboot", "icon": "system-reboot", "level": "warn",
                 "title": "Reboot pending", "detail": f"running kernel {running} is no longer installed"}]
    return []


def check_failed_units():
    units = []
    for scope in ([], ["--user"]):
        _, out = run(["systemctl", *scope, "--failed", "--plain", "--no-legend"])
        for line in out.splitlines():
            if line.strip():
                units.append(("user " if scope else "") + line.split()[0])
    if not units:
        return [{"id": "units", "icon": "run-build", "level": "ok", "title": "No failed services", "detail": ""}]
    return [{"id": "units", "icon": "run-build", "level": "error",
             "title": f"{len(units)} failed service{'s' if len(units) != 1 else ''}",
             "detail": ", ".join(u.replace("\\x2d", "-") for u in units[:3]), "action": "Fix",
             "prompt": "These systemd units have failed: " + ", ".join(units) +
                       ". Find out why from their logs and fix them (or disable them if they're obsolete)."}]


def check_disks(mounts):
    # btrfs subvolumes (/ and /home on CachyOS) share one device: report it once.
    sources = {}
    with open("/proc/self/mounts") as f:
        for line in f:
            dev, mnt = line.split()[:2]
            sources[mnt.replace("\\040", " ")] = dev
    checks, seen = [], set()
    for m in mounts:
        if not os.path.ismount(m) or sources.get(m, m) in seen:
            continue
        seen.add(sources.get(m, m))
        st = os.statvfs(m)
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        if not total:
            continue
        pct = round(100 * (1 - free / total))
        level = "error" if pct >= 95 else "warn" if pct >= 85 else "ok"
        check = {"id": f"disk:{m}", "icon": "drive-harddisk", "level": level,
                 "title": f"{m} {pct}% full", "detail": f"{free / 1e9:.0f} GB free of {total / 1e9:.0f} GB"}
        if level != "ok":
            check.update(action="Clean up", prompt=DEFAULT_CONFIG["actions"][2]["prompt"] + f" Focus on {m}.")
        checks.append(check)
    return checks


def recent_crashes(since="-24h"):
    code, out = run(["coredumpctl", "list", f"--since={since}", "--json=short", "--no-pager"])
    if code != 0 or not out.strip():
        return []
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return []


def check_crashes(muted):
    crashes = [c for c in recent_crashes() if Path(c.get("exe", "")).name not in muted and c.get("exe") not in muted]
    if not crashes:
        return [{"id": "crashes", "icon": "tools-report-bug", "level": "ok", "title": "No crashes today", "detail": ""}]
    last = crashes[-1]
    names = sorted({Path(c["exe"]).name for c in crashes})
    ago = human_delta(time.time() - last["time"] / 1e6)
    return [{"id": "crashes", "icon": "tools-report-bug", "level": "warn",
             "title": f"{len(crashes)} crash{'es' if len(crashes) != 1 else ''} in 24h",
             "detail": f"last: {Path(last['exe']).name} {ago} ago" + (f" · also {', '.join(n for n in names if n != Path(last['exe']).name)[:60]}" if len(names) > 1 else ""),
             "action": "Diagnose", "prompt": crash_prompt(last["pid"], last["exe"])}]


def check_journal():
    _, out = run(["journalctl", "-b", "-p", "3", "-q", "--no-pager", "-o", "cat"], timeout=30)
    n = len([line for line in out.splitlines() if line.strip()])
    if not n:
        return []
    return [{"id": "journal", "icon": "view-list-text", "level": "info",
             "title": f"{n} error log line{'s' if n != 1 else ''} this boot", "detail": "journalctl -b -p err",
             "action": "Review", "prompt": DEFAULT_CONFIG["actions"][3]["prompt"]}]


def crash_prompt(pid, exe):
    return (f"Process {exe} (PID {pid}) crashed and left a core dump. Diagnose it: start with "
            f"`coredumpctl info {pid}`, get a backtrace with `coredumpctl debug {pid} --debugger-arguments='-batch -ex \"thread apply all bt\"'` "
            f"(debuginfod is fine to use), and look at the journal around the crash time. "
            f"Tell me the likely cause, whether it's a known upstream bug or something local, and what to do about it. "
            f"If it's noise I can ignore, say so and offer to mute it with `desktop-agent mute {Path(exe).name}`.")


def status(force=False):
    cfg = load_config()
    cache = Cache()
    active = get_agent(cfg)
    usage = usage_all(cache, force, first=AGENT_TYPES[active["type"]]["provider"])
    checks = []
    for fn in (lambda: check_updates(cache, force), check_pacnew, check_reboot, check_failed_units,
               lambda: check_disks(cfg["disk_mounts"]), lambda: check_crashes(set(cfg["muted"])), check_journal):
        try:
            checks.extend(fn())
        except Exception as e:  # one broken check must not blank the widget
            checks.append({"id": "error", "icon": "dialog-error", "level": "info",
                           "title": "Check failed", "detail": str(e)[:120]})
    order = {"error": 0, "warn": 1, "info": 2, "ok": 3}
    checks.sort(key=lambda c: order.get(c["level"], 9))
    attention = sum(1 for c in checks if c["level"] in ("error", "warn"))
    worst = checks[0]["level"] if checks else "ok"
    return {"usage": usage, "checks": checks, "actions": cfg["actions"],
            "agents": {"active": active["id"],
                       "list": [{"id": a["id"], "name": a["name"]} for a in agent_list(cfg)]},
            "attention": attention, "worst": worst, "updated": time.strftime("%H:%M")}


# ---------------------------------------------------------------- launching

def ensure_workspace():
    """Copy the agent instructions into the workspace as real files. Symlinks would make Claude Code
    resolve CLAUDE.md's imports next to the link target, outside the workspace: that triggers its
    external-imports prompt and misses workspace/local.md."""
    WORKSPACE.mkdir(parents=True, exist_ok=True)
    for name in ("AGENTS.md", "CLAUDE.md"):
        src, dst = APP_ROOT / "workspace" / name, WORKSPACE / name
        if not src.is_file():
            continue
        text = src.read_text()
        if dst.is_symlink() or not dst.is_file() or dst.read_text() != text:
            dst.unlink(missing_ok=True)
            dst.write_text(text)
    return WORKSPACE


def agent_command(agent):
    kind = AGENT_TYPES[agent["type"]]
    cmd = [which(kind["command"]) or kind["command"]]
    if agent["model"]:
        cmd += [kind["model_flag"], agent["model"]]
    cmd += next(p[2] for p in kind["permissions"] if p[0] == agent["permissions"])
    return cmd + agent["args"]


def launch(prompt=None, agent_id=None):
    cfg = load_config()
    ensure_workspace()
    agent = get_agent(cfg, agent_id)
    cmd = [part.replace("{workspace}", str(WORKSPACE)).replace("{name}", agent["name"])
           for part in cfg["terminal"]]
    cmd += agent_command(agent)
    if prompt:
        cmd.append(prompt)
    # Run in its own transient scope so the session outlives plasmashell / the watch service.
    if which("systemd-run"):
        cmd = ["systemd-run", "--user", "--scope", "--quiet", "--collect",
               f"--unit=desktop-agent-{int(time.time() * 1000)}", *cmd]
    subprocess.Popen(cmd, cwd=WORKSPACE, start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---------------------------------------------------------------- watch service

def notify(title, body, icon, actions=None, on_action=None):
    """Send a desktop notification; if actions are given, wait for a click in a thread."""
    cmd = ["notify-send", "-a", "Desktop Agent", "-i", icon]
    for key, label in (actions or {}).items():
        cmd.append(f"--action={key}={label}")
    cmd += [title, body]

    def worker():
        code, out = run(cmd, timeout=3600)
        if on_action and out.strip():
            on_action(out.strip())

    threading.Thread(target=worker, daemon=True).start()


def watch_crashes():
    last_seen = {}
    proc = subprocess.Popen(["journalctl", "-f", "-n", "0", "-o", "json", "SYSLOG_IDENTIFIER=systemd-coredump"],
                            stdout=subprocess.PIPE, text=True)
    for line in proc.stdout:
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            continue
        pid, exe = ev.get("COREDUMP_PID"), ev.get("COREDUMP_EXE")
        if not pid or not exe:
            continue
        cfg = load_config()
        name = Path(exe).name
        if not cfg["crash_capture"] or name in cfg["muted"] or exe in cfg["muted"]:
            continue
        if time.time() - last_seen.get(exe, 0) < 120:  # crash loops: one notification per program
            continue
        last_seen[exe] = time.time()
        sig = ev.get("COREDUMP_SIGNAL_NAME") or f"signal {ev.get('COREDUMP_SIGNAL', '?')}"

        def on_action(action, pid=pid, exe=exe, name=name):
            if action == "diagnose":
                launch(crash_prompt(pid, exe))
            elif action == "mute":
                mute(name)

        notify("Process crashed", f"{name} ({sig}, PID {pid})", "tools-report-bug",
               {"diagnose": "Diagnose", "mute": f"Mute {name}"}, on_action)


def watch_usage():
    alerted = {}
    cache = Cache()
    while True:
        try:
            for usage in usage_all(cache, force=True):
                for lim in usage.get("limits", []):
                    key = f"{usage['id']}|{lim['label']}|{lim.get('reset_ts')}"
                    if lim["percent"] >= USAGE_ALERT_PERCENT and key not in alerted:
                        alerted[key] = True
                        notify(f"{usage['name']} usage limit", f"{lim['label']}: {lim['detail']}", "dialog-warning")
            # Updates are slow to compute; refreshing them here keeps the widget's popup instant.
            cache.get("updates", UPDATES_TTL, fetch_updates)
        except Exception as e:
            print(f"usage watch: {e}", file=sys.stderr, flush=True)
        time.sleep(USAGE_TTL)


def watch():
    threading.Thread(target=watch_usage, daemon=True).start()
    while True:
        try:
            watch_crashes()
        except Exception as e:
            print(f"crash watch: {e}", file=sys.stderr, flush=True)
        time.sleep(5)


def mute(name, on=True):
    cfg = load_config()
    muted = [m for m in cfg["muted"] if m != name]
    if on:
        muted.append(name)
    cfg["muted"] = muted
    save_config(cfg)


# ---------------------------------------------------------------- global shortcut

# kglobalaccel identifies the launcher by its .desktop file, and takes keys as Qt key codes.
SHORTCUT_ACTION = "['desktop-agent.desktop','_launch','Desktop Agent','Desktop Agent']"
QT_MODIFIERS = {"Shift": 0x02000000, "Ctrl": 0x04000000, "Alt": 0x08000000, "Meta": 0x10000000, "Num": 0x20000000}
QT_KEYS = {
    "Esc": 0x01000000, "Escape": 0x01000000, "Tab": 0x01000001, "Backspace": 0x01000003,
    "Return": 0x01000004, "Enter": 0x01000005, "Ins": 0x01000006, "Insert": 0x01000006,
    "Del": 0x01000007, "Delete": 0x01000007, "Pause": 0x01000008, "Print": 0x01000009,
    "SysReq": 0x0100000A, "Home": 0x01000010, "End": 0x01000011, "Left": 0x01000012,
    "Up": 0x01000013, "Right": 0x01000014, "Down": 0x01000015, "PgUp": 0x01000016,
    "PgDown": 0x01000017, "Menu": 0x01000055, "Space": 0x20,
    **{f"F{n}": 0x01000030 + n - 1 for n in range(1, 36)},
}


def keys_to_code(text):
    """'Meta+Shift+A' -> Qt key code. A trailing '+' key is written 'Ctrl++'."""
    parts = text.split("+")
    if text.endswith("++"):
        parts = parts[:-2] + ["+"]
    *mods, key = parts
    code = 0
    for m in mods:
        if m not in QT_MODIFIERS:
            raise ValueError(f"unknown modifier {m!r}")
        code |= QT_MODIFIERS[m]
    if key in QT_KEYS:
        return code | QT_KEYS[key]
    if len(key) == 1:
        return code | ord(key.upper())
    raise ValueError(f"unknown key {key!r}")


def code_to_keys(code):
    names = [name for name, bit in QT_MODIFIERS.items() if code & bit]
    names.sort(key=["Meta", "Ctrl", "Alt", "Shift", "Num"].index)
    key = code & 0x01FFFFFF
    by_code = {v: k for k, v in reversed(QT_KEYS.items())}
    names.append(by_code.get(key) or chr(key))
    return "+".join(names)


def kglobalaccel(method, *args):
    code, out = run(["gdbus", "call", "--session", "--dest", "org.kde.kglobalaccel",
                     "--object-path", "/kglobalaccel", "--method", f"org.kde.KGlobalAccel.{method}", *args])
    if code != 0:
        raise RuntimeError(f"kglobalaccel {method} failed")
    return out


def get_shortcut():
    out = kglobalaccel("shortcut", SHORTCUT_ACTION)  # e.g. "([301989953],)"
    codes = [int(c) for c in out.strip("()[],\n ").replace("@ai", "").split(",") if c.strip().isdigit()]
    return code_to_keys(codes[0]) if codes else ""


def set_shortcut(text):
    keys = f"[{keys_to_code(text)}]" if text else "@ai []"
    kglobalaccel("doRegister", SHORTCUT_ACTION)
    kglobalaccel("setShortcut", SHORTCUT_ACTION, keys, "6")  # SetPresent | NoAutoloading


# ---------------------------------------------------------------- main

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "status":
        print(json.dumps(status(force="--refresh" in args)))
    elif cmd == "launch":
        agent_id = None
        if args[:1] == ["--agent"] and len(args) > 1:
            agent_id, args = args[1], args[2:]
        if args[:1] == ["--"]:
            args = args[1:]
        launch(" ".join(args).strip() or None, agent_id)
    elif cmd == "agents":
        if args[:1] == ["set"] and len(args) > 1:
            try:
                set_agents(args[1])
            except (ValueError, json.JSONDecodeError) as e:
                print(f"desktop-agent: {e}", file=sys.stderr)
                return 2
        print(json.dumps(agents_info(load_config())))
    elif cmd == "workspace":
        print(ensure_workspace())
    elif cmd == "use" and args:
        try:
            use_agent(args[0])
        except ValueError as e:
            print(f"desktop-agent: {e}", file=sys.stderr)
            return 2
    elif cmd == "diagnose" and args:
        exe = next((c["exe"] for c in recent_crashes("-30d") if str(c["pid"]) == args[0]), "unknown executable")
        launch(crash_prompt(args[0], exe))
    elif cmd == "watch":
        watch()
    elif cmd in ("mute", "unmute"):
        if not args:
            print("\n".join(load_config()["muted"]) or "(nothing muted)")
        else:
            mute(args[0], cmd == "mute")
    elif cmd == "shortcut":
        if args:
            try:
                set_shortcut(args[0].strip())
            except ValueError as e:
                print(f"desktop-agent: {e}", file=sys.stderr)
                return 2
        print(get_shortcut())
    elif cmd == "config":
        print(f"# {CONFIG_PATH}")
        print(json.dumps(load_config(), indent=2))
    else:
        print(f"desktop-agent: unknown command {cmd!r}; see --help", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
